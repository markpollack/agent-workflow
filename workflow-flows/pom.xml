<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.markpollack</groupId>
        <artifactId>agent-workflow-parent</artifactId>
        <version>0.13.0-SNAPSHOT</version>
    </parent>

    <artifactId>workflow-flows</artifactId>
    <name>Workflow Flows</name>
    <description>Composable step-based flow combinators for agent workflows (sequential, parallel, loop)</description>

    <dependencies>
        <!-- Consumer-visible floors for runtime families otherwise governed only by the parent. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson3.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson3.version}</version>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <!-- workflow-api provides AgentContext, ContextKey, AgentHandler -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>workflow-api</artifactId>
        </dependency>

        <!-- workflow-core provides GraphCompositionStrategy for GraphStep -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>workflow-core</artifactId>
        </dependency>

        <!-- Spring AI ChatClient for ChatClientStep -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- A2A Protocol SDK (optional — A2AStep remote agent invocation) -->
        <dependency>
            <groupId>io.github.a2asdk</groupId>
            <artifactId>a2a-java-sdk-client</artifactId>
            <version>0.3.3.Final</version>
            <optional>true</optional>
        </dependency>

        <!-- Anthropic Java SDK (optional — ManagedAgentStep) -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.57.0</version>
            <optional>true</optional>
        </dependency>

        <!-- Agent Judge (optional — JudgeGate, TieredGate) -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-judge-core</artifactId>
            <version>${agent-judge.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Agent Client (test only — integration tests for AgentClientStep trace wiring) -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-client-core</artifactId>
            <version>0.29.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-claude</artifactId>
            <version>0.29.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
